{
  "name": "hackathon-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test": "node --import ./tests/support/register.mjs --test \"tests/unit/*.test.mts\"",
    "test:db": "node --env-file-if-exists=.env.local --import ./tests/support/register.mjs --test \"tests/db/*.test.mts\"",
    "db:seed:local": "node --env-file=.env.local --import ./tests/support/register.mjs scripts/seed-local.mts",
    "docs:api": "node --import ./tests/support/register.mjs scripts/gen-openapi.mts",
    "gen:idea-validator": "node scripts/gen-idea-validator.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.2",
    "ai": "^7.0.150",
    "next": "^16.4.2",
    "nodemailer": "10.0.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
